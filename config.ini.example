[API]
url = https://www.colorful.cn/Home/GetProductDownload?mid=84&id=040eff36-32dd-4a26-8f63-7c9498db4fef

[LOCAL]
state_file = last_bios_version.txt
log_file = run.log

[NOTIFICATION]
# 通知方式: email / notify_send / ntfy / print / none
method = ntfy
# 未检查到新版本时是否发送通知: true / false
notify_on_no_update = false

[EMAIL]
smtp_server = smtp.example.com
smtp_port = 25
sender_email = your_email@example.com
sender_password = your_password
receiver_email = receiver@example.com

[NTFY]
server = http://your-ntfy-server:port
topic = colorful-bios
username = your_username
password = your_password
# 新版本通知优先级 (1-5)
priority_new_version = 4
# 无新版本通知优先级 (1-5)
priority_no_update = 2
